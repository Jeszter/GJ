  m_Script: {fileID: 11500000, guid: 74c47e3a0cf4baa409a657f200a9f294, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GJ.Game.ReadableNote
  text: "They built this chapel when the\nmine still had men in it.\n\nFour rooms
    under it, and every\none of them took me more than once.\n\nThe way up is chained.
    A round\nwould do. Or the other thing.\n\n                        - M."
