  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 74c47e3a0cf4baa409a657f200a9f294, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GJ.Game.ReadableNote
  text: "The ones who gave up down here\nnever left. They put on the robes\nand wait
    past that door for the\nnext one to give up too.\n\nThe way up is chained. A
    round\nwould do. Or the other thing.\nDon't. That's how they began.\n\n                       
    - M."
