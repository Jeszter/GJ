  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 74c47e3a0cf4baa409a657f200a9f294, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GJ.Game.ReadableNote
  text: 'DAY 5


    The pump room. The old cistern

    still holds water.


    The
    door bolt hangs on a chain

    over to a bucket. Fill the bucket,

    the bolt
    comes up.


    It never fills in one breath.'
--- !u!23 &1066832758
