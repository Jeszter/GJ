--- !u!114 &980178724
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 980178722}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 74c47e3a0cf4baa409a657f200a9f294, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GJ.Game.ReadableNote
  text: 'DAY 5


    The pump room. The old cistern

    still holds water.


    The
    door bolt hangs on a chain

    over to a bucket. Fill the bucket,

    the bolt
    comes up.


    It never fills in one breath.'
--- !u!23 &980178725
